{
  "schemaVersion": 1,
  "id": "jm2bm",
  "version": "${version}",
  "name": "Jm2Bm",
  "description": "Synchronizes JourneyMap global waypoints to existing BlueMap marker sets.",
  "authors": ["Jm2Bm contributors"],
  "contact": {
    "homepage": "https://github.com/Crispy-Monke-eSports/Jm2Bm",
    "sources": "https://github.com/Crispy-Monke-eSports/Jm2Bm",
    "issues": "https://github.com/Crispy-Monke-eSports/Jm2Bm/issues"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": ["se.jesper.jm2bm.fabric.Jm2BmFabric"],
    "journeymap_server": ["se.jesper.jm2bm.journeymap.JourneyMapServerPlugin"]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "journeymap": ">=${journeymap_runtime_version}",
    "bluemap": ">=5.0.0"
  }
}
